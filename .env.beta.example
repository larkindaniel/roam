# Deploying to the hosted beta (roam-beta) with scripts/deploy-beta.py.
# Copy this file to .env.beta (git ignores it) and paste your token below. Never commit a real token.
#
# To get a token: Supabase dashboard -> your account -> Access Tokens -> Generate new token.
#   Resource access: Project, organisation Roam, project roam-beta.
#   Permissions: Database SQL/migrations read and write; Edge Functions read and write;
#                Auth config read (write only to run configure-auth); API keys read. Nothing else.
# Then: chmod 600 .env.beta, and see docs/hosted-beta.md for the commands.
SUPABASE_PROJECT_REF=xnjzuotytfzyppubjcfi
SUPABASE_ACCESS_TOKEN=sbp_your_token_here
