// Copy to Config/Local.xcconfig (ignored by git) and fill in values from
// `supabase status` for this project's local stack. scripts/configure-local.sh does this
// automatically and only writes the public API URL and publishable key.
ROAM_SUPABASE_URL = http:/$()/127.0.0.1:54321
ROAM_SUPABASE_PUBLISHABLE_KEY = <publishable-or-anon-key-from-supabase-status>
